{
  "name": "relay-dsh-plugin-events",
  "version": "0.2.1-rc.1",
  "description": "Durable provider-neutral Wait, Event, and Delivery runtime for DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "events",
    "agents"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/host-plugin.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangbobo2021/relay-dsh-plugin-events.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "prepare:dsh": "scripts/link-dsh-development-peers.sh",
    "pretest": "npm run prepare:dsh",
    "prebuild": "npm run prepare:dsh && node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsdown --config tsdown.config.ts",
    "postbuild": "node normalize-build.mjs",
    "pretypecheck": "npm run prepare:dsh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs test/runtime/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "exports": {
    ".": "./lib/host-plugin.js",
    "./client": "./lib/client.js",
    "./contracts": "./contracts/index.mjs",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.zh.md",
    "README.md",
    "SPEC.md",
    "docs",
    "contracts",
    "cordis.patch.yml",
    "lib/client.js",
    "lib/client.js.map",
    "lib/host-plugin.js",
    "lib/host-plugin.js.map",
    "lib/typert.host.js",
    "lib/typert.host.js.map"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "lightningcss": "1.32.0",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  }
}
